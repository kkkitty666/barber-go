# App (HTTPS, без слэша в конце). Используется для metadata, sitemap, robots, JSON-LD.
NEXT_PUBLIC_APP_URL=https://pc-barbershop.ru

# Онлайн-запись YCLIENTS (опционально; по умолчанию — салон n2371242)
# NEXT_PUBLIC_BOOKING_URL=https://n2371242.yclients.com

# Telegram — создай бота в @BotFather, группу для заказов
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=
# Случайная строка (A-Za-z0-9_-); Telegram secret_token → заголовок X-Telegram-Bot-Api-Secret-Token
# После деплоя/ротации: npm run telegram:webhook
TELEGRAM_WEBHOOK_SECRET=
# Отдельный секрет для POST /api/telegram/setup (не webhook). На проде без него setup отключён.
TELEGRAM_ADMIN_SECRET=

# Supabase — ОБЯЗАТЕЛЬНО на проде (NODE_ENV=production / Vercel). Без этих переменных заказы/остатки вернут 503.
# Локально без них — JSON в /data
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Max messenger — личная ссылка вида https://max.ru/u/... (опционально; без неё Max не показывается)
NEXT_PUBLIC_MAX_URL=

# Яндекс.Метрика — числовой ID счётчика (опционально)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Vercel Cron — секрет для автосинхронизации отзывов (Authorization: Bearer …)
# Project Settings → Environment Variables → CRON_SECRET
CRON_SECRET=

# Быстрая настройка Telegram одной командой:
# npm run telegram:setup
# После деплоя зарегистрировать webhook (и после ротации TELEGRAM_WEBHOOK_SECRET):
# npm run telegram:webhook
